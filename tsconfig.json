{
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "removeComments": false, 
    "outDir": "types",
    "rootDir": "src",
    "paths": {
      "@moneko/common": ["./src/index.ts"]
    }
  },
  "exclude": ["src/__tests__"],
  "include": ["src", "typings"]
}